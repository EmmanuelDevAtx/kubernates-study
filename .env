kubectl create secret generic db-secret \
  --namespace=zafra \
  --from-literal=POSTGRES_DB="test" \
  --from-literal=POSTGRES_USER="test" \
  --from-literal=POSTGRES_PASSWORD="test" \
  --from-literal=POSTGRES_HOST="postgres" \
  --from-literal=POSTGRES_PORT="5432"


kubectl create secret generic backend-secret \
  --namespace=zafra \
  --from-literal=DATABASE_HOST="postgres" \

kubectl create secret docker-registry secret_docker \
  --namespace=zafra \
  --docker-server=https://anyregistry/ \
  --docker-username=test \
  --docker-password=test

kubectl create secret generic frontend-secret \
  --namespace=zafra \
